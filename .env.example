# Copy to .env and edit. Anything left out falls back to a development default.

# --- core -----------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
# Needed once the site runs behind a domain over HTTPS:
# CSRF_TRUSTED_ORIGINS=https://example.com

# --- branding -------------------------------------------------------------
SITE_NAME=Milan
SITE_TAGLINE=Where two journeys become one
# Used to build the links inside verification emails — must be the public URL.
SITE_BASE_URL=http://127.0.0.1:8000

# --- database -------------------------------------------------------------
# Omit for SQLite (default). For PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/milan

# --- email ----------------------------------------------------------------
# With EMAIL_HOST unset, messages are printed to the console instead of sent,
# which is what you want locally.
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=Milan <no-reply@example.com>
EMAIL_VERIFICATION_TIMEOUT_HOURS=48

# --- uploads --------------------------------------------------------------
MAX_PHOTOS_PER_PROFILE=10
MAX_PHOTO_SIZE_MB=8
PHOTO_MAX_DIMENSION=1600
PHOTO_JPEG_QUALITY=85
# MEDIA_ROOT=/var/www/milan/media

TIME_ZONE=UTC
